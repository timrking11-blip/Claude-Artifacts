# Copy to .env and fill in. `set -o allexport; . .env; set +o allexport` to load.

# 1 -> Vertex AI (recommended; uses Application Default Credentials)
GOOGLE_GENAI_USE_VERTEXAI=1

# Vertex backend
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
# Only needed if the MCP toolsets want the number rather than the ID:
# gcloud projects describe $GOOGLE_CLOUD_PROJECT --format="value(projectNumber)"
# GOOGLE_CLOUD_PROJECT_NUMBER=
# Claude on Vertex accepts "global"; Gemini and BigQuery want a region.
GOOGLE_CLOUD_LOCATION=global
# Storage bucket for Agent Runtime deployment (must already exist)
GOOGLE_CLOUD_STORAGE_BUCKET=YOUR_BUCKET

# --- Model -------------------------------------------------------------------
# anthropic (default): Claude through the Anthropic API. No Google Cloud
#   project, ADC or Model Garden needed. The SDK finds the credential itself:
#   ANTHROPIC_API_KEY below, or a profile from `ant auth login`.
# claude: the same model served from Vertex AI (needs the GOOGLE_CLOUD_*
#   values above and Model Garden enablement).
# gemini: the template's Gemini path.
ACCOUNT_RESEARCH_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5 is the default: a prequalification proposal from structured
# research does not need the Fable tier, at half the price per token.
# claude-fable-5-1 opts back in; claude-sonnet-5 is the cheaper step down.
ACCOUNT_RESEARCH_CLAUDE_MODEL=claude-opus-5
# Optional: low | medium | high | xhigh | max. Unset = the API default (high).
# ACCOUNT_RESEARCH_CLAUDE_EFFORT=high
# ACCOUNT_RESEARCH_MAX_TOKENS=16000
# Used only when ACCOUNT_RESEARCH_MODEL_PROVIDER=gemini
GOOGLE_GENAI_MODEL=gemini-2.5-flash

# BigQuery dataset the deployment/bigquery_setup.py script creates
GOOGLE_CLOUD_BQ_DATASET=crm

# Ledger to research. Default: ../../data/master/contacts.json in this repo.
# ACCOUNT_RESEARCH_LEDGER=/path/to/contacts.json
# Where "prequal <account>: <request>" writes its proposal. Default: ../../data/proposals
# ACCOUNT_RESEARCH_PROPOSALS=/path/to/proposals

# Attach the Google Cloud MCP servers (BigQuery, Agent Registry) as tools.
ACCOUNT_RESEARCH_ENABLE_MCP=0

ACCOUNT_RESEARCH_LOG_LEVEL=INFO

# --- Observability (off by default) ------------------------------------------
# Agent spans -> Cloud Trace. Covers the whole run on any provider, including
# Claude on Vertex. Needs roles/cloudtrace.agent on the running identity.
# ACCOUNT_RESEARCH_TRACE_TO_CLOUD=1
# ACCOUNT_RESEARCH_OTEL_TO_CLOUD=1
# Same, for the Agent Runtime deployment (deployment/deploy.py).
# ACCOUNT_RESEARCH_ENABLE_TRACING=1
