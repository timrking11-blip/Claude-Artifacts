{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude-artifacts/architecture/schemas/evidence-ledger.schema.json",
  "title": "Evidence ledger",
  "description": "One research project's source register, claim ledger, contradictions and search log, kept separate from the narrative so it can be reviewed and reused. One schema for every research profile (docs/research-profiles.md). Its objects are ADR-012's proposed shapes: sources are Observations; a claim citing a source is Evidence with its stance; FACT claims are Claims; INFERENCE and ASSUMPTION claims are Hypotheses; contradictions are Contradictions; source_ids and superseded_by are ProvenanceEdges. Ledgers are files: nothing writes them into the CRM. crm/ledger.py validates this schema plus the integrity rules a JSON Schema cannot state (every cited source id exists, every quote has its locator, every source has an access date, a FACT rests on a reviewed source).",
  "type": "object",
  "required": ["sources", "claims"],
  "properties": {
    "profile": {
      "enum": ["full", "lean"],
      "default": "full",
      "description": "full: legal, health, privacy, market sizing, or any claim that will be published or shown outside SMI (proposals included). lean: development research, a claim ledger plus sources only. Absent means full."
    },
    "brief": {
      "type": "object",
      "required": ["version", "date", "research_question", "decision_supported"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "date": {"type": "string", "format": "date"},
        "project": {"type": "string"},
        "research_question": {"type": "string"},
        "decision_supported": {"type": "string"},
        "decision_owner": {"type": "string"},
        "intended_users": {"type": "string"},
        "jurisdictions": {"type": "array", "items": {"type": "string"}},
        "time_period": {"type": "string"},
        "data_involved": {"type": "string"},
        "intended_use": {"type": "string"},
        "out_of_scope": {"type": "array", "items": {"type": "string"}},
        "sources_required_or_avoided": {"type": "string"},
        "reviewers": {"type": "array", "items": {"type": "string"}},
        "specialist_review": {"type": "array", "items": {"type": "string"}, "description": "Legal, privacy, security, clinical or regulatory review the findings need before use"},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from_version", "what", "why"],
            "properties": {
              "from_version": {"type": "integer"},
              "what": {"type": "string"},
              "why": {"type": "string"},
              "claims_to_recheck": {"type": "array", "items": {"$ref": "#/$defs/claimId"}}
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "locator_url", "accessed", "reviewed"],
        "properties": {
          "id": {"$ref": "#/$defs/sourceId"},
          "title": {"type": "string"},
          "issuer": {"type": "string"},
          "source_type": {"enum": ["primary", "peer_reviewed", "institutional_report", "journalism", "commentary_or_marketing"]},
          "locator_url": {"type": "string"},
          "published": {"type": ["string", "null"]},
          "accessed": {"type": "string", "format": "date"},
          "locator": {"type": "string", "description": "Page, section, table, endpoint or figure. Required whenever the source carries a quote"},
          "quote": {"type": "string", "description": "A verbatim quotation relied on. Never invented; needs a locator"},
          "excerpt": {"type": "string", "description": "A faithful description of the passage relied on (or a quotation, which then needs a locator)"},
          "supports": {"type": "string"},
          "does_not_establish": {"type": "string"},
          "limits": {"type": "string", "description": "Access, version, licence or coverage limits actually verified"},
          "reviewed": {"type": "boolean", "description": "false when only a search snippet or listing was seen"},
          "checksum_or_archive": {"type": ["string", "null"], "description": "Only if a tool produced one"}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "status", "confidence"],
        "properties": {
          "id": {"$ref": "#/$defs/claimId"},
          "claim": {"type": "string"},
          "status": {"enum": ["FACT", "INFERENCE", "ASSUMPTION", "UNVERIFIED_LEAD"]},
          "source_ids": {"type": "array", "items": {"$ref": "#/$defs/sourceId"}},
          "evidence_type": {"enum": ["causal", "quasi_experimental", "descriptive", "qualitative", "expert_guidance", "legal_text", "other"]},
          "scope_covered": {"type": "string", "description": "Population, market, place and period the evidence covers"},
          "applies": {"enum": ["directly", "extrapolated"]},
          "conflicts": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "confidence_reason": {"type": "string"},
          "recheck_by": {"type": ["string", "null"], "format": "date"},
          "superseded_by": {"oneOf": [{"$ref": "#/$defs/claimId"}, {"type": "null"}]}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "FACT"}}},
            "then": {"required": ["source_ids"], "properties": {"source_ids": {"minItems": 1}}}
          }
        ]
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim_ids", "note", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^CONTRA-[0-9]{3,}$"},
          "claim_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claimId"}},
          "source_ids": {"type": "array", "items": {"$ref": "#/$defs/sourceId"}},
          "note": {"type": "string", "description": "What disagrees, and why it may"},
          "status": {"enum": ["open", "resolved"]}
        }
      }
    },
    "search_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "tool", "query"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "tool": {"type": "string"},
          "query": {"type": "string"},
          "filters": {"type": "string"},
          "kept": {"type": "string"},
          "excluded": {"type": "string"},
          "not_accessible": {"type": "string"}
        }
      }
    },
    "gaps": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"not": {"properties": {"profile": {"const": "lean"}}}},
      "then": {
        "required": ["brief", "sources", "claims", "search_log"],
        "properties": {
          "sources": {"items": {"required": ["id", "title", "issuer", "source_type", "locator_url", "accessed", "excerpt", "supports", "reviewed"]}},
          "claims": {"items": {"required": ["id", "claim", "status", "evidence_type", "applies", "confidence", "confidence_reason"]}}
        }
      }
    }
  ],
  "$defs": {
    "claimId": {"type": "string", "pattern": "^CLAIM-[0-9]{3,}$"},
    "sourceId": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"}
  }
}
